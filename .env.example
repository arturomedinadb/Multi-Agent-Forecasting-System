# OpenAI API key (required) — the agents will not run without this.
OPENAI_API_KEY=your-key-here

# Model used by the agents (optional, default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Logging verbosity (optional, default: INFO)
LOG_LEVEL=INFO

# DeepEval API key (optional) — enables cloud-based evaluation metrics
# (Task Completion, Tool Correctness, Answer Relevancy) in the schema
# mapping evaluator agents. Metrics are skipped gracefully if unset.
DEEPEVAL_API_KEY=your-key-here

# Flask session secret for the web UI (optional; only needed for production)
FLASK_SECRET_KEY=your-secret-key-here
